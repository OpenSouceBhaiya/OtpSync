{
  "manifest_version": 3,
  "name": "OTP Sync",
  "version": "1.0.0",
  "description": "Instantly beam OTPs from Gmail, SMS, WhatsApp & any notification to your PC clipboard. End-to-End Encrypted.",
  "permissions": [
    "clipboardWrite",
    "storage",
    "offscreen",
    "alarms",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "https://otpsync-adf52-default-rtdb.asia-southeast1.firebasedatabase.app/*",
    "https://otpsync-adf52-default-rtdb.firebaseio.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OTP Sync"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icon48.png", "ting_sound.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}
